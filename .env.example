# ─────────────────────────────────────────────────────────────────────
# Molde de configuração — ITSM Enterprise
#
# Copie para `.env` na raiz do projeto e ajuste os valores. O `.env` está
# no .gitignore: é lá que ficam os dados deste ambiente, e ele nunca vai
# para o repositório.
#
#     cp .env.example .env        # Linux / macOS
#     Copy-Item .env.example .env # Windows (PowerShell)
#
# Todas as variáveis são opcionais: sem nenhuma delas o projeto roda em
# modo de desenvolvimento, com SQLite e sem integração com o AD.
# ─────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────

# 1 em desenvolvimento, 0 em produção.
ITSM_DEBUG=1

# Obrigatória quando ITSM_DEBUG=0 — o projeto se recusa a iniciar sem ela,
# para não rodar com a chave de desenvolvimento que está no código público.
# Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ITSM_SECRET_KEY=troque-por-uma-chave-aleatoria-de-50-caracteres

# Domínios que podem servir a aplicação, separados por vírgula.
# O padrão '*' vale para desenvolvimento; em produção, liste os reais.
# ITSM_ALLOWED_HOSTS=itsm.suaempresa.com,10.0.0.50

# ── Active Directory / LDAP ──────────────────────────────────────────
# Documentação completa: docs/AD_LDAP.md
# Valide a configuração antes de ligar: python manage.py ldap_check

# 1 liga a autenticação pelo domínio. Com 0 (padrão), o login usa apenas
# as senhas locais do banco.
ITSM_LDAP_ENABLED=0

# Use o NOME do controlador de domínio, não o IP: o certificado é emitido
# para o nome, então validar TLS por IP falha sempre.
ITSM_LDAP_SERVER=dc01.exemplo.local
ITSM_LDAP_DOMAIN=exemplo.local
ITSM_LDAP_SEARCH_BASE=DC=exemplo,DC=local

# 636 = LDAPS, o padrão recomendado. Exige certificado de servidor
# instalado no controlador de domínio (normalmente via AD CS).
# 389 = LDAP puro: funciona sem certificado, mas a senha de domínio
# trafega EM TEXTO CLARO pela rede. O `manage.py check` avisa.
ITSM_LDAP_PORT=636

# Cifra a conexão na porta 389. Também exige certificado no servidor.
ITSM_LDAP_START_TLS=0

# Validar o certificado do servidor é o padrão. A CA interna do domínio
# costuma não ser conhecida pelo Python: exporte-a e aponte o arquivo.
ITSM_LDAP_TLS_VALIDATE=1
# ITSM_LDAP_CA_CERT_FILE=/caminho/para/ca-do-dominio.pem

# Segundos de espera pelo servidor. É o tempo que a tela de login demora
# quando o controlador de domínio não responde.
ITSM_LDAP_TIMEOUT=5

# Seguir grupos aninhados (grupo que é membro de outro grupo).
# Custa uma consulta a mais por login.
ITSM_LDAP_NESTED_GROUPS=0

# Conta de serviço — NORMALMENTE DESNECESSÁRIA. O bind é feito com o
# próprio usuário que está entrando, e os atributos e grupos dele são
# lidos com essa mesma conexão. Preencha só se o seu AD restringir a
# leitura do diretório.
# ITSM_LDAP_BIND_DN=CN=svc-itsm,OU=Servicos,DC=exemplo,DC=local
# ITSM_LDAP_BIND_PASSWORD=
